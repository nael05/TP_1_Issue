# Copiez ce fichier en .env et remplissez-le. Ce fichier-ci EST versionné,
# .env ne l'est jamais : une chaîne de connexion contient un mot de passe.

# Obligatoire. Format : postgresql+psycopg://utilisateur:motdepasse@hote:5432/base
DATABASE_URL=postgresql+psycopg://postgres:motdepasse@localhost:5432/jeux

# Obligatoire. Générez la vôtre, et une DIFFÉRENTE en production :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Qui détient cette clé peut forger un jeton d'administrateur.
CLE_SECRETE=remplacez_par_une_cle_generee

# Facultatives
DUREE_JETON_MINUTES=30
ORIGINES_AUTORISEES=http://localhost:5173
ENVIRONNEMENT=developpement
NIVEAU_JOURNAL=INFO
ECHO_SQL=false
MAX_TENTATIVES_CONNEXION=5
FENETRE_TENTATIVES_MINUTES=15
